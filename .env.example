# =============================================================================
# WATCHER — environment variables
# Copy to .env.local and fill in. NEVER commit real secrets.
# Only NEXT_PUBLIC_* variables are visible to the browser — no secret may use
# that prefix. All API keys below are read server-side only.
# =============================================================================

# --- Persistence --------------------------------------------------------------
# local    = JSON file in WATCHER_LOCAL_DATA_DIR (default; fine on your own machine)
# supabase = Supabase/PostgreSQL (apply supabase/migrations first)
WATCHER_DATA_BACKEND=local
WATCHER_LOCAL_DATA_DIR=.watcher-data

# Supabase (required when WATCHER_DATA_BACKEND=supabase)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# uuid of your user in auth.users (and the matching row in public.users)
WATCHER_OWNER_USER_ID=

# --- Access protection (strongly recommended if deployed anywhere) ------------
WATCHER_BASIC_AUTH_USER=
WATCHER_BASIC_AUTH_PASSWORD=

# --- Market data ---------------------------------------------------------------
# mock = synthetic development data (clearly labelled, refused in production
#        builds unless WATCHER_ALLOW_MOCK_IN_PRODUCTION=true)
# none = no market data; the UI shows "unavailable"
# Default: mock in development, none in production. Real providers: Phase 2.
MARKET_DATA_PROVIDER=mock
MARKET_DATA_API_KEY=

# --- Analysis (reasoning layer) -----------------------------------------------
# mock = transparent rule-based placeholder (not Claude). Claude: Phase 2.
ANALYSIS_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- News & sentiment (Phase 2) -----------------------------------------------
NEWS_PROVIDER=none
NEWS_API_KEY=
SENTIMENT_PROVIDER=none
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- TradingView alert webhooks (Phase 5) -------------------------------------
TRADINGVIEW_WEBHOOK_SECRET=

# Must be "true" to allow mock providers in a production build (private demo only).
WATCHER_ALLOW_MOCK_IN_PRODUCTION=false
